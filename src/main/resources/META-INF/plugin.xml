<idea-plugin>
    <id>org.taigaui.designtokens</id>
    <name>Taiga UI Design Tokens</name>
    <vendor url="https://github.com/taiga-family-labs">Taiga Family</vendor>

    <description><![CDATA[
        <p>WebStorm support for Taiga UI design tokens.</p>
        <p>The plugin reads the installed <code>@taiga-ui/design-tokens</code> package and provides structured documentation with resolved values and color previews for CSS custom properties.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>JavaScript</depends>
    <depends>com.intellij.css</depends>

    <extensions defaultExtensionNs="com.intellij">
        <platform.backend.documentation.targetProvider
            implementation="org.taigaui.designtokens.documentation.DesignTokenDocumentationTargetProvider"
        />
        <editorFactoryMouseMotionListener
            implementation="org.taigaui.designtokens.documentation.DesignTokenHoverPopupListener"
        />
    </extensions>
</idea-plugin>
